# Copie para .env e ajuste os valores.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Se acessar por IP/domínio, inclua aqui com http(s)://, ex.: http://192.168.0.10:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL - usuário da APLICAÇÃO (sem privilégios de superusuário)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=troque-esta-senha
# Docker: senha do superusuário "postgres" (só para pgAdmin/manutenção; o ERP nunca usa)
POSTGRES_ADMIN_PASSWORD=troque-esta-senha-admin
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Portas (Docker). WEB_BIND=127.0.0.1 se usar o proxy HTTPS (perfil "https")
WEB_BIND=0.0.0.0
WEB_PORT=8000
PGADMIN_BIND=127.0.0.1
PGADMIN_PORT=5050

# Segurança
# 1 = cookies só por HTTPS + HSTS (ative quando acessar por https://)
DJANGO_HTTPS=0
# 1 somente atrás de proxy reverso (Caddy/nginx) que define X-Forwarded-For/Proto
CONFIAR_X_FORWARDED_FOR=0
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
SESSAO_HORAS=8
ARQUIVO_MAX_MB=50

# Assinatura digital (ICP-Brasil)
# Pasta com as ACs raiz/intermediárias da ICP-Brasil para validar cadeias (opcional)
ICP_BRASIL_CAS_DIR=
# Servidor de carimbo do tempo RFC 3161 (opcional, gera PAdES com carimbo)
ASSINATURA_TSA_URL=

# Primeiro administrador (criado automaticamente no Docker). Depois do 1º acesso, troque a senha
# pela tela e apague DJANGO_SUPERUSER_PASSWORD deste arquivo.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@empresa.com.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
# 1 = carregar dados fictícios de demonstração (NUNCA em produção: cria usuários com senha conhecida)
CARREGAR_DEMO=0

# pgAdmin (administração do banco pela web)
PGADMIN_EMAIL=admin@empresa.com.br
PGADMIN_PASSWORD=troque-esta-senha
PGADMIN_URL=http://localhost:5050

# E-mail (régua de cobrança). Sem configurar, os e-mails aparecem no log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=financeiro@empresa.com.br

# Compras: tolerância de preço na conferência em três vias (%).
# As alçadas de aprovação são cadastradas na tela Compras → Alçadas de aprovação.
COMPRAS_TOLERANCIA_PRECO_PCT=2

# Módulos operacionais (padrões entre parênteses)
# ESTOQUE_PERMITE_NEGATIVO=0
# VENDAS_DESCONTO_MAXIMO_PCT=10
# MANUTENCAO_ANTECEDENCIA_DIAS=7
# PROJETOS_HORAS_MES=220
# PROJETOS_ENCARGOS_FATOR=1.0
# SST_ALERTA_DIAS=30
# SERVICEDESK_HORARIO=08:00-18:00
# SERVICEDESK_DIAS_FECHAMENTO=3
# Endereço do ERP para os links nos e-mails de aviso
# ERP_URL_BASE=https://erp.empresa.com.br
# Chave que cifra o certificado A1 no banco (texto longo e aleatório; guarde com o backup)
# FISCAL_CHAVE_COFRE=

# NFS-e pelo Emissor Nacional: produção só com 1 (libere depois de testar em homologação).
# FISCAL_NFSE_NACIONAL_PRODUCAO=0
# XSD oficial da DPS (opcional): confere o XML antes de enviar.
# FISCAL_NFSE_NACIONAL_XSD=
# FISCAL_NFSE_NACIONAL_TIMEOUT=60
# Pacote de certificados confiáveis para a conexão com a Sefin (opcional).
# FISCAL_NFSE_NACIONAL_CA_BUNDLE=

# Dias para manter logs de erro já tratados (a trilha de auditoria nunca é apagada)
LOG_ERRO_RETENCAO_DIAS=180

# ---- Backup automático (diário, cifrado, com retenção e cópia externa) ----
# Frase longa que cifra os backups. GUARDE-A FORA DO SERVIDOR: sem ela o backup não abre.
# BACKUP_SENHA=
# BACKUP_HORA=02:00
# BACKUP_DIR=/app/backups
# Cópia externa (disco USB/NAS montado) e/ou comando (rclone, rsync, scp...). {arquivo} vira o caminho do backup.
# BACKUP_COPIA_DIR=/copia
# BACKUP_COMANDO_COPIA=rclone copy {arquivo} nuvem:guara-backups
# Retenção: últimos N dias, semanas e meses
# BACKUP_RETENCAO_DIARIOS=7
# BACKUP_RETENCAO_SEMANAIS=4
# BACKUP_RETENCAO_MENSAIS=12

# (SSO: o endereço de retorno do provedor usa o ERP_URL_BASE definido acima.)

# ---- Gateway de pagamento (boleto/PIX com baixa automática) ----
# Produção travada até você liberar; valide tudo no sandbox primeiro (a chave e o webhook são configurados na tela
# Administração -> Gateway de pagamento, não aqui).
# COBRANCA_GATEWAY_PRODUCAO=0

# ---- Verificação em duas etapas (2FA) ----
# Obrigatória para superusuários e estes grupos (separe por vírgula); os demais podem ativar na conta.
# MFA_GRUPOS_OBRIGATORIOS=Administradores,Financeiro
# MFA_ATIVO=1

# ---- Antivírus dos uploads (ClamAV) ----
# Ligado por padrão; se o ClamAV cair, os envios de arquivo são RECUSADOS. Desligar (não recomendado): ANTIVIRUS_ATIVO=0
# ANTIVIRUS_ATIVO=1
# No Docker o serviço "clamav" já vem configurado. Instalação nativa: aponte para o seu clamd.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl     # alternativa ao TCP (Linux)
# Maior arquivo que o antivírus verifica (<= StreamMaxLength do clamd). Envio máximo do ERP: ARQUIVO_MAX_MB (50).
# ANTIVIRUS_LIMITE_MB=100
# CLAMD_LIMITE_MB=100

# Chaves de segurança (WebAuthn). Normalmente basta ERP_URL_BASE com o endereço público em HTTPS.
# WEBAUTHN_RP_ID=erp.suaempresa.com.br
# WEBAUTHN_ORIGENS=https://erp.suaempresa.com.br
