# Copie para .env e ajuste os valores.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Se acessar por IP/domínio, inclua aqui com http(s)://, ex.: http://192.168.0.10:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL - usuário da APLICAÇÃO (sem privilégios de superusuário)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=troque-esta-senha
# Docker: senha do superusuário "postgres" (só para pgAdmin/manutenção; o ERP nunca usa)
POSTGRES_ADMIN_PASSWORD=troque-esta-senha-admin
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Portas (Docker). WEB_BIND=127.0.0.1 se usar o proxy HTTPS (perfil "https")
WEB_BIND=0.0.0.0
WEB_PORT=8000
PGADMIN_BIND=127.0.0.1
PGADMIN_PORT=5050

# Segurança
# 1 = cookies só por HTTPS + HSTS (ative quando acessar por https://)
DJANGO_HTTPS=0
# 1 somente atrás de proxy reverso (Caddy/nginx) que define X-Forwarded-For/Proto
CONFIAR_X_FORWARDED_FOR=0
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
SESSAO_HORAS=8
ARQUIVO_MAX_MB=50

# Assinatura digital (ICP-Brasil)
# Pasta com as ACs raiz/intermediárias da ICP-Brasil para validar cadeias (opcional)
ICP_BRASIL_CAS_DIR=
# Servidor de carimbo do tempo RFC 3161 (opcional, gera PAdES com carimbo)
ASSINATURA_TSA_URL=

# Primeiro administrador (criado automaticamente no Docker). Depois do 1º acesso, troque a senha
# pela tela e apague DJANGO_SUPERUSER_PASSWORD deste arquivo.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@empresa.com.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
# 1 = carregar dados fictícios de demonstração (NUNCA em produção: cria usuários com senha conhecida)
CARREGAR_DEMO=0

# pgAdmin (administração do banco pela web)
PGADMIN_EMAIL=admin@empresa.com.br
PGADMIN_PASSWORD=troque-esta-senha
PGADMIN_URL=http://localhost:5050

# E-mail (régua de cobrança). Sem configurar, os e-mails aparecem no log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=financeiro@empresa.com.br

# Compras: tolerância de preço na conferência em três vias (%).
# As alçadas de aprovação são cadastradas na tela Compras → Alçadas de aprovação.
COMPRAS_TOLERANCIA_PRECO_PCT=2

# Módulos operacionais (padrões entre parênteses)
# ESTOQUE_PERMITE_NEGATIVO=0
# VENDAS_DESCONTO_MAXIMO_PCT=10
# MANUTENCAO_ANTECEDENCIA_DIAS=7
# PROJETOS_HORAS_MES=220
# PROJETOS_ENCARGOS_FATOR=1.0
# SST_ALERTA_DIAS=30
